<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matule_background">

    <LinearLayout
        android:id="@+id/sideMenuContent"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@color/matule_white"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/sideMenuCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_shop_round_light"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/matule_text_dark"
            android:textSize="34sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_sprint5_avatar"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/matule_white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sideMenuUserNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mors"
                    android:textColor="@color/matule_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="test123@mail.com"
                    android:textColor="@color/matule_text_gray"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sideMenuItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sideMenuLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_sprint5_outline_button"
            android:gravity="center"
            android:text="@string/side_menu_logout"
            android:textColor="@color/matule_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

