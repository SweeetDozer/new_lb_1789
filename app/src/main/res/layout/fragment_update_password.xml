<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matule_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="720dp"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/updateBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="@string/screen_back"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/matule_text_dark"
            android:textSize="30sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/updateTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:gravity="center"
            android:text="@string/update_password_title"
            android:textColor="@color/matule_text_dark"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/updateDescriptionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/update_password_description"
            android:textColor="@color/matule_text_gray"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updateTitleTextView" />

        <TextView
            android:id="@+id/updatePasswordLabelTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/update_password_label"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updateDescriptionTextView" />

        <FrameLayout
            android:id="@+id/updatePasswordContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/field_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updatePasswordLabelTextView">

            <EditText
                android:id="@+id/newPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="52dp"
                android:background="@android:color/transparent"
                android:hint="@string/update_password_hint"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:textColor="@color/matule_text_dark"
                android:textColorHint="@color/matule_hint_gray"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/newPasswordToggleButton"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@android:color/transparent"
                android:contentDescription="@string/update_password_label"
                android:padding="12dp"
                android:src="@drawable/ic_eye" />
        </FrameLayout>

        <TextView
            android:id="@+id/passwordStrengthTextView"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:text="@string/update_password_strength_weak"
            android:textColor="@color/matule_text_gray"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/updatePasswordContainer" />

        <TextView
            android:id="@+id/repeatPasswordLabelTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/update_password_repeat_label"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/passwordStrengthTextView" />

        <FrameLayout
            android:id="@+id/repeatPasswordContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/field_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/repeatPasswordLabelTextView">

            <EditText
                android:id="@+id/repeatPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="52dp"
                android:background="@android:color/transparent"
                android:hint="@string/update_password_repeat_hint"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:textColor="@color/matule_text_dark"
                android:textColorHint="@color/matule_hint_gray"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/repeatPasswordToggleButton"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@android:color/transparent"
                android:contentDescription="@string/update_password_repeat_label"
                android:padding="12dp"
                android:src="@drawable/ic_eye" />
        </FrameLayout>

        <TextView
            android:id="@+id/captchaLabelTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/update_password_captcha_label"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/repeatPasswordContainer" />

        <TextView
            android:id="@+id/captchaTextView"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_captcha"
            android:gravity="center"
            android:text="A7K9"
            android:textColor="@color/matule_text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/captchaEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/captchaLabelTextView"
            app:layout_constraintWidth_percent="0.32" />

        <EditText
            android:id="@+id/captchaEditText"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_input"
            android:hint="@string/update_password_captcha_hint"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/matule_text_dark"
            android:textColorHint="@color/matule_hint_gray"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/captchaTextView"
            app:layout_constraintTop_toTopOf="@id/captchaTextView" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/savePasswordButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="28dp"
            android:text="@string/update_password_save"
            android:textAllCaps="false"
            android:textColor="@color/matule_white"
            android:textSize="16sp"
            app:backgroundTint="@color/matule_primary"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/captchaTextView" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
