<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matule_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/checkoutBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_shop_round_light"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/matule_text_dark"
                android:textSize="32sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/checkout_title"
                android:textColor="@color/matule_text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/checkout_email"
            android:textColor="@color/matule_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/checkoutEmailEditText"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shop_search"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/checkout_phone"
            android:textColor="@color/matule_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/checkoutPhoneEditText"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shop_search"
            android:inputType="phone"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/checkout_address"
            android:textColor="@color/matule_text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/checkoutProfileAddressTextView"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_shop_selected_card"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/checkout_profile_address"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/checkoutGeoAddressTextView"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shop_card"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/checkout_geo_address"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/checkoutAddressEditText"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shop_search"
            android:inputType="textPostalAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/checkoutSummaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_shop_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/checkoutSubtotalTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/matule_text_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/checkoutDeliveryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/matule_text_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/checkoutTotalTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/matule_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/checkoutConfirmButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_blue_button"
            android:text="@string/checkout_confirm"
            android:textAllCaps="false"
            android:textColor="@color/matule_white"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
