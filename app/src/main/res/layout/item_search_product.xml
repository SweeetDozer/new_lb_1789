<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:background="@drawable/bg_shop_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/searchProductImageView"
        android:layout_width="96dp"
        android:layout_height="72dp"
        android:contentDescription="@string/search_title"
        android:scaleType="centerCrop"
        android:src="@drawable/img_onboard_1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/searchProductNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/matule_text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/searchProductCategoryTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:textColor="@color/matule_text_gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/searchProductPriceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/matule_text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/searchProductAddButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_shop_add_button"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/matule_white"
        android:textSize="26sp" />
</LinearLayout>
