<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matule_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="640dp"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/forgotBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="@string/screen_back"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/matule_text_dark"
            android:textSize="30sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/forgotTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="92dp"
            android:gravity="center"
            android:text="@string/forgot_password_title"
            android:textColor="@color/matule_text_dark"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/forgotDescriptionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/forgot_password_description"
            android:textColor="@color/matule_text_gray"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/forgotTitleTextView" />

        <EditText
            android:id="@+id/forgotEmailEditText"
            android:layout_width="0dp"
            android:layout_height="@dimen/field_height"
            android:layout_marginTop="46dp"
            android:background="@drawable/bg_input"
            android:hint="@string/sign_in_email_hint"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/matule_text_dark"
            android:textColorHint="@color/matule_hint_gray"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/forgotDescriptionTextView" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgotSendButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="40dp"
            android:text="@string/forgot_password_send"
            android:textAllCaps="false"
            android:textColor="@color/matule_white"
            android:textSize="16sp"
            app:backgroundTint="@color/matule_primary"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/forgotEmailEditText" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
