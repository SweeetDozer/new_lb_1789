<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matule_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profileBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_shop_round_light"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/matule_text_dark"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/profile_title"
                android:textColor="@color/matule_text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_sprint5_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/profileAvatarTextView"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_sprint5_avatar"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/matule_white"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileChangePhotoButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/profile_change_photo"
                android:textColor="@color/matule_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/profileNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/matule_text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileEmailTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/matule_text_gray"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/profilePhoneTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/matule_text_gray"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileLoyaltyCard"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_shop_sale"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_loyalty_title"
                    android:textColor="@color/matule_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileLoyaltyTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/matule_text_gray"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_sprint5_qr_white"
                android:gravity="center"
                android:text="QR"
                android:textColor="@color/matule_text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/profileEditButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_blue_button"
            android:text="@string/profile_edit"
            android:textAllCaps="false"
            android:textColor="@color/matule_white"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>

