<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matule_text_dark">

    <TextView
        android:id="@+id/qrCloseButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="24dp"
        android:background="@drawable/bg_shop_round_light"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/matule_text_dark"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_loyalty_title"
            android:textColor="@color/matule_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/qrPlaceholderGrid"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_sprint5_qr_white"
            android:columnCount="5"
            android:padding="24dp"
            android:rowCount="5">

            <!-- QR placeholder for laboratory task. -->
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView
                style="@style/QrCellLight"
                android:gravity="center"
                android:text="QR"
                android:textColor="@color/matule_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
            <TextView style="@style/QrCellLight" />
            <TextView style="@style/QrCellDark" />
        </GridLayout>

        <TextView
            android:id="@+id/qrDataTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/matule_white"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>

